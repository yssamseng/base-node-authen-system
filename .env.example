# Service Configuration
SERVICE_NAME=node-auth-api
SERVICE_VERSION=1.0.0

# Server Configuration
PORT=3000
NODE_ENV=development

# Docker Configuration (uncomment when using Docker)
# When using docker-compose, DB_HOST should be 'postgres' not 'localhost'
# DB_DOCKER_HOST=postgres

# Database Configuration
# For local development: DB_HOST=localhost
# For Docker: DB_HOST=postgres
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=test-auth
DB_USER=postgres
DB_PASSWORD=123456

# Redis Configuration (optional - for rate limiting in production)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# For Docker: REDIS_HOST=redis

# Database Connection Retry Configuration
# Maximum number of retry attempts when database connection fails (default: 10)
DB_RETRY_MAX=10
# Initial delay before first retry in milliseconds (default: 2000)
DB_RETRY_DELAY=2000
# Maximum delay between retries in milliseconds (default: 30000)
DB_RETRY_MAX_DELAY=30000
# Whether to retry database sync if it fails after connection (default: true)
DB_RETRY_SYNC=true
# Health check interval for runtime database monitoring in milliseconds (default: 60000)
# Lower values = faster detection but more database load
# Recommended: 60000 (60s) for production, 30000 (30s) for development
DB_HEALTH_CHECK_INTERVAL=60000

# JWT Configuration
# IMPORTANT: JWT_SECRET must be at least 32 characters long
# Generate a strong secret using: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_must_be_at_least_32_characters_long_for_security
JWT_EXPIRE=24h
JWT_ACCESS_EXPIRE=15m
# IMPORTANT: JWT_REFRESH_SECRET must be DIFFERENT from JWT_SECRET
# This is critical for security - prevents token type confusion attacks
JWT_REFRESH_SECRET=your_different_refresh_token_secret_at_least_32_chars
JWT_REFRESH_EXPIRE=7d

# CORS Configuration
# Single origin: CORS_ORIGIN=http://localhost:3000
# Multiple origins: CORS_ORIGIN=http://localhost:3000,https://example.com,https://app.example.com
CORS_ORIGIN=http://localhost:3000

# Email Configuration
EMAIL_PROVIDER=smtp

# SMTP Configuration (for EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_REJECT_UNAUTHORIZED=true

# Gmail Configuration (for EMAIL_PROVIDER=gmail)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# Email General Settings
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME=Application Team
FRONTEND_URL=http://localhost:3000

# Email Verification Configuration
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_EXPIRY_HOURS=24
ALLOW_UNVERIFIED_LOGIN=true
VERIFICATION_RESEND_COOLDOWN=5
MAX_VERIFICATION_ATTEMPTS=3

# Verification Requirements
REQUIRE_EMAIL_VERIFICATION_FOR_LOGIN=false
REQUIRE_EMAIL_VERIFICATION_FOR_PROFILE=false
REQUIRE_EMAIL_VERIFICATION_FOR_SENSITIVE=false

# Logtail Configuration (Optional - leave empty to disable)
LOGTAIL_SOURCE_TOKEN=
LOGTAIL_ENDPOINT=

# Docker Compose Configuration (optional - only when using docker-compose)
# PgAdmin Configuration (web-based PostgreSQL management)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Docker Ports (modify if default ports are in use)
# POSTGRES_PORT=5432
# REDIS_PORT=6379
