# Service Configuration
SERVICE_NAME=node-auth-api
SERVICE_VERSION=1.0.0

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=test-auth
DB_USER=postgres
DB_PASSWORD=123456

# Database Connection Retry Configuration
DB_RETRY_MAX=10
DB_RETRY_DELAY=2000
DB_RETRY_MAX_DELAY=30000
DB_RETRY_SYNC=true
DB_HEALTH_CHECK_INTERVAL=60000

# JWT Configuration
# IMPORTANT: Generate strong secrets with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_must_be_at_least_32_characters_long_for_security
JWT_EXPIRE=24h
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_SECRET=your_different_refresh_token_secret_at_least_32_chars
JWT_REFRESH_EXPIRE=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Logging Configuration
LOG_LEVEL=debug

# Logtail Configuration
LOGTAIL_SOURCE_TOKEN=SUH8P8D99C5TveJnEbwacZhF
LOGTAIL_ENDPOINT=https://s1564615.eu-nbg-2.betterstackdata.com
