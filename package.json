{
  "name": "node-auth-api",
  "version": "1.0.0",
  "description": "Node.js Express authentication system with Sequelize and PostgreSQL",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all"
  },
  "keywords": [
    "nodejs",
    "express",
    "rest-api",
    "authentication",
    "auth",
    "jwt",
    "sequelize",
    "postgresql",
    "mysql",
    "api",
    "backend",
    "security",
    "nodemailer",
    "validation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@logtail/node": "^0.5.6",
    "@logtail/winston": "^0.5.6",
    "async-local-storage": "^2.3.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.5",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.10",
    "pg": "^8.11.3",
    "sequelize": "^6.35.2",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@swc/core": "^1.15.8",
    "@swc/jest": "^0.2.39",
    "babel-jest": "^30.2.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "esbuild-jest": "^0.5.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^30.2.0",
    "nodemon": "^3.0.2",
    "sequelize-cli": "^6.6.2",
    "supertest": "^6.3.3"
  }
}
